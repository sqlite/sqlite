# Regression tests for compound-subquery flattening with parser-generated
# co-routines in sibling FROM-clause terms.
set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix unionall3

do_execsql_test 1.0 {
  CREATE TABLE t1(a INTEGER PRIMARY KEY);
  CREATE TABLE t2(a INT);
  INSERT INTO t1 VALUES(1),(2),(3);
  INSERT INTO t2 VALUES(1),(5);
} {}

do_execsql_test 1.1 {
  SELECT q1.a, q0.column1
    FROM (VALUES(1),(2),(3)) AS q0,
         (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1
   ORDER BY 1, 2;
} {1 1  1 1  1 2  1 2  1 3  1 3  2 1  2 2  2 3
   3 1  3 2  3 3  5 1  5 2  5 3}

do_execsql_test 1.2 {
  SELECT q1.a, q0.column1
    FROM (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1,
         (VALUES(1),(2),(3)) AS q0
   ORDER BY 1, 2;
} {1 1  1 1  1 2  1 2  1 3  1 3  2 1  2 2  2 3
   3 1  3 2  3 3  5 1  5 2  5 3}

do_execsql_test 1.3 {
  SELECT q1.a, q0.column1
    FROM (SELECT * FROM (VALUES(1),(2),(3)) LIMIT -1) AS q0,
         (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1
   ORDER BY 1, 2;
} {1 1  1 1  1 2  1 2  1 3  1 3  2 1  2 2  2 3
   3 1  3 2  3 3  5 1  5 2  5 3}

do_execsql_test 1.4 {
  SELECT q1.a, q0.column1
    FROM (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1,
         (SELECT * FROM (VALUES(1),(2),(3)) LIMIT -1) AS q0
   ORDER BY 1, 2;
} {1 1  1 1  1 2  1 2  1 3  1 3  2 1  2 2  2 3
   3 1  3 2  3 3  5 1  5 2  5 3}

do_execsql_test 1.5 {
  SELECT q1.a, q0.column1
    FROM (VALUES(1),(2),(3)) AS q0,
         (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1
   ORDER BY 1 DESC, 2 DESC;
} {5 3  5 2  5 1  3 3  3 2  3 1  2 3  2 2  2 1
   1 3  1 3  1 2  1 2  1 1  1 1}

do_execsql_test 1.6 {
  SELECT count(*) FROM (
    SELECT q1.a, q0.column1
      FROM (VALUES(1),(2),(3),(4)) AS q0,
           (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1
     ORDER BY 1, 2
  );
} {20}

do_execsql_test 1.7 {
  SELECT count(*) FROM (
    SELECT q1.a, q0.column1, q2.column1
      FROM (VALUES(1),(2),(3)) AS q0,
           (VALUES(10),(20)) AS q2,
           (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1
     ORDER BY 1, 2, 3
  );
} {30}

do_execsql_test 1.8 {
  SELECT count(*) FROM (
    SELECT q1.a, q0.column1
      FROM (VALUES(1),(2),(3)) AS q0,
           (SELECT a FROM t1 UNION ALL SELECT a FROM t2) AS q1
  );
} {15}

finish_test
