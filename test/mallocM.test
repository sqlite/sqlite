#***********************************************************************
# Further OOM tests.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
source $testdir/malloc_common.tcl
set testprefix mallocM

sqlite3_db_config_lookaside db 0 0 0

do_execsql_test 1.0 {
  CREATE TABLE t1(x);
}
do_faultsim_test 1 -faults oom* -body {
  execsql {
    SELECT 'abc' FROM ( SELECT 'xyz' FROM t1 WHERE (SELECT 1) )
  }
} -test {
  faultsim_test_result {0 {}}
}

do_execsql_test 2.0.1 { SELECT instr(x'', x'') }         {1}
do_execsql_test 2.0.2 { SELECT instr(x'12345678', x'') } {1}
do_execsql_test 2.0.3 { SELECT instr(x'', x'1234') }     {0}

do_faultsim_test 2.1 -faults oom* -body {
  execsql { SELECT instr (x'00', zeroblob(1)) }
} -test {
  faultsim_test_result {0 1}
}

do_faultsim_test 2.2 -faults oom* -body {
  execsql { SELECT instr (zeroblob(1), x'00') }
} -test {
  faultsim_test_result {0 1}
}

#-------------------------------------------------------------------------
# An OOM while opening the TEMP database used to be reported as
# "unable to open a temporary database file for storing temporary
# tables", even with temp_store=memory.
#
reset_db
do_execsql_test 3.0 {
  CREATE TABLE t1(a PRIMARY KEY, b);
  CREATE INDEX t1b ON t1(b);
  INSERT INTO t1 VALUES(1, 2), (3, 4);
}
faultsim_save_and_close
do_faultsim_test 3 -faults oom* -prep {
  faultsim_restore_and_reopen
  execsql { PRAGMA temp_store = memory }
} -body {
  execsql { PRAGMA integrity_check }
} -test {
  faultsim_test_result {0 ok}
}

#-------------------------------------------------------------------------
# An OOM while copying a run-time error message from the VM to the
# database handle used to cause SQLITE_ERROR to be returned along with
# the generic "SQL logic error" message.
#
reset_db
do_execsql_test 4.0 {
  CREATE TABLE t1(x);
}
faultsim_save_and_close
do_faultsim_test 4 -faults oom* -prep {
  faultsim_restore_and_reopen
} -body {
  execsql { SELECT abs(-9223372036854775807 - 1) }
} -test {
  faultsim_test_result {1 {integer overflow}}
}

finish_test
