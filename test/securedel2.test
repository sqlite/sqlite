#
# Tests for the secure_delete pragma.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set ::testprefix securedel2

# Generate 1000 pseudo-random 64-bit blobs.
#
for {set i 1} {$i <= 1000} {incr i} {
  set aBlob($i) [string range [db one {SELECT quote(randomblob(8))}] 2 end-1]
}

proc detect_blob_prepare {zFile} {
  set nByte [file size $zFile]
  set ::detect_blob_data [hexio_read $zFile 0 $nByte]
}

proc detect_blob {zFile iBlob} {
  if {$zFile != ""} { detect_blob_prepare $zFile }
  string match "*$::aBlob($iBlob)*" $::detect_blob_data
}

do_test 1.1 {
  execsql { PRAGMA secure_delete = 1 }
  execsql { PRAGMA auto_vacuum = 0 }
  execsql { CREATE TABLE t1(x, y) }
  for {set i 1} {$i <= 1000} {incr i} {
    set x "X'[string repeat $aBlob($i) 1]'"
    set y "X'[string repeat $aBlob($i) 500]'"
    execsql "INSERT INTO t1 VALUES($x, $y)"
  }
} {}

do_test         1.2   { detect_blob test.db 1 } {1}

forcecopy test.db test.db.bak
do_execsql_test 1.3.1 { PRAGMA secure_delete = 0 } {0}
do_execsql_test 1.3.2 { DELETE FROM t1 WHERE rowid = 1 }
do_test         1.3.3 { detect_blob test.db 1 } {1}

db close
forcecopy test.db.bak test.db
sqlite3 db test.db
do_execsql_test 1.4.1 { PRAGMA secure_delete = 1 } {1}
do_execsql_test 1.4.2 { DELETE FROM t1 WHERE rowid = 1 }
do_test         1.4.3 { detect_blob test.db 1 } {0}

do_execsql_test 1.5.1 { DELETE FROM t1 WHERE rowid>850 } {}
do_test 1.5.2 { 
  set n 0
  detect_blob_prepare test.db
  for {set i 851} {$i <= 1000} {incr i 5} {
    incr n [detect_blob {} $i]
  }
  set n
} {0}

db close
sqlite3 db test.db
do_test 1.6.1 { 
  execsql {
    PRAGMA cache_size = 200;
    PRAGMA secure_delete = 1;
    CREATE TABLE t2(x);
    SELECT * FROM t1;
  }
  for {set i 100} {$i < 5000} {incr i} {
    execsql { INSERT INTO t2 VALUES(randomblob($i)) }
  }
  execsql { DELETE FROM t1 }
} {}

do_test 1.6.2 { 
  set n 0
  detect_blob_prepare test.db
  for {set i 2} {$i <= 850} {incr i 5} {
    incr n [detect_blob {} $i]
  }
  set n
} {0}

#-------------------------------------------------------------------------
# Bug 2026-11-27T19:39:50Z sqlite.org/bugs/info/ca6b6a575365363d
# With secure_delete on, deleted content must not be left in the unused
# part of a b-tree page.  Rebalancing used to copy bytes past the end of
# the cell pointer array into the gap before the cell content area.
#
proc file_has_text {zFile zText} {
  set fd [open $zFile rb]
  set data [read $fd]
  close $fd
  expr {[string first $zText $data]>=0}
}
proc file_count_text {zFile zText} {
  set fd [open $zFile rb]
  set data [read $fd]
  close $fd
  regexp -all $zText $data
}

reset_db
do_execsql_test 2.1 {
  PRAGMA page_size = 4096;
  PRAGMA secure_delete = ON;
  CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
  BEGIN;
    WITH s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<600)
    INSERT INTO t SELECT i, printf('SECRET_ROW_%04d_CONFIDENTIAL', i) FROM s;
  COMMIT;
  DELETE FROM t WHERE id <= 100;
  DELETE FROM t WHERE id IN (228, 341, 342);
} {1}
do_test 2.2 {
  set n 0
  foreach i {1 50 100 228 341 342} {
    incr n [file_has_text test.db [format SECRET_ROW_%04d_CONFIDENTIAL $i]]
  }
  set n
} {0}
do_execsql_test 2.3 { PRAGMA integrity_check } {ok}

#-------------------------------------------------------------------------
# Bug 2026-11-27T19:42:27Z sqlite.org/bugs/info/575f60b3d69ed80b
# An incremental-vacuum step moves the last page of the database and
# truncates the file at commit. If the same transaction then extends the
# database over that page again, the old content of the page must not
# reappear in the new page.
#
foreach {tn ps pk sz ok sd nLeak} {
  1  512  616  60  480   1  0
  2  512  616  60  480   2  0
  3  4096 4200 480 4200  1  0
  4  512  616  60  480   0  15
} {
  reset_db
  do_test 3.$tn.1 {
    db eval "PRAGMA page_size = $ps"
    db eval {
      PRAGMA auto_vacuum = INCREMENTAL;
      CREATE TABLE pub(x BLOB);
      CREATE TABLE sec(x TEXT);
      CREATE TABLE ovf(x BLOB);
    }
    db eval "PRAGMA secure_delete = $sd"
    db eval {
      INSERT INTO pub VALUES(zeroblob($pk));
      INSERT INTO sec VALUES(replace(hex(zeroblob($sz)), '00', 'SENSITIVE_'));
      BEGIN;
        DELETE FROM pub;
        PRAGMA incremental_vacuum(1);
        INSERT INTO ovf VALUES(zeroblob($ok));
        DELETE FROM sec;
      COMMIT;
      PRAGMA incremental_vacuum;
    }
    file_count_text test.db SENSITIVE_
  } $nLeak
  do_execsql_test 3.$tn.2 { PRAGMA integrity_check } {ok}
}

finish_test
