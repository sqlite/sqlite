#***********************************************************************
# Round-trip of one qualified keyword name through stored schema text.
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl

ifcapable !altertable {
  finish_test
  return
}

reset_db
do_execsql_test schemaquote-1.1 {
  CREATE TABLE main.IF(a);
  SELECT sql FROM sqlite_schema;
} {{CREATE TABLE "IF"(a)}}
do_execsql_test schemaquote-1.2 {
  INSERT INTO "IF" VALUES(1);
  ALTER TABLE "IF" ADD COLUMN b DEFAULT 4;
  INSERT INTO "IF"(a) VALUES(2);
  SELECT a, b FROM "IF" ORDER BY a;
} {1 4 2 4}
do_execsql_test schemaquote-1.3 {
  SELECT count(*) FROM pragma_table_info('IF');
} {2}
do_test schemaquote-1.4 {
  db close
  sqlite3 db test.db
  execsql {SELECT a, b FROM "IF" ORDER BY a}
} {1 4 2 4}
do_execsql_test schemaquote-1.5 {
  ALTER TABLE "IF" RENAME COLUMN b TO c;
  SELECT a, c FROM "IF" ORDER BY a;
} {1 4 2 4}
do_execsql_test schemaquote-1.6 {
  ALTER TABLE "IF" RENAME TO kept;
  SELECT a, c FROM kept ORDER BY a;
} {1 4 2 4}

reset_db
do_execsql_test schemaquote-2.1 {
  CREATE TABLE main.IF(a PRIMARY KEY) WITHOUT ROWID;
  INSERT INTO "IF" VALUES(3);
  ALTER TABLE "IF" ADD COLUMN b DEFAULT 9;
  SELECT a, b FROM "IF";
} {3 9}

reset_db
do_execsql_test schemaquote-3.1 {
  CREATE TABLE main.if(a);
  INSERT INTO "if" VALUES(5);
  SELECT a FROM "IF";
} {5}
reset_db
do_execsql_test schemaquote-3.2 {
  CREATE TABLE main."IF"(b);
  SELECT count(*) FROM "IF";
} {0}
do_catchsql_test schemaquote-3.3 {
  CREATE TABLE main.IF(b);
} {1 {table IF already exists}}

reset_db
do_catchsql_test schemaquote-4.1 {
  CREATE TABLE IF(a);
} {1 {near "(": syntax error}}
do_execsql_test schemaquote-4.2 {
  CREATE TABLE main.TEMP(a);
  SELECT sql FROM sqlite_schema;
} {{CREATE TABLE TEMP(a)}}
do_execsql_test schemaquote-4.3 {
  CREATE TABLE main.RAISE(a);
  SELECT count(*) FROM "RAISE";
} {0}
do_execsql_test schemaquote-4.4 {
  CREATE TABLE main.t1(a);
  CREATE TABLE IF NOT EXISTS main.t1(b);
  INSERT INTO t1 VALUES(6);
  SELECT * FROM t1;
} {6}
do_execsql_test schemaquote-4.5 {
  CREATE TABLE main.[IF](a);
  SELECT sql FROM sqlite_schema WHERE name='IF';
} {{CREATE TABLE [IF](a)}}

reset_db
do_execsql_test schemaquote-5.1 {
  CREATE TABLE main.IF AS SELECT 3 AS a;
  SELECT a FROM "IF";
} {3}

ifcapable view {
  reset_db
  do_execsql_test schemaquote-6.1 {
    CREATE VIEW main.IF AS SELECT 1 AS v;
    SELECT sql FROM sqlite_schema;
    SELECT v FROM "IF";
  } {{CREATE VIEW "IF" AS SELECT 1 AS v} 1}
}

reset_db
do_execsql_test schemaquote-7.1 {
  CREATE TABLE t1(a);
  CREATE INDEX main.IF ON t1(a);
  SELECT sql FROM sqlite_schema WHERE type='index';
} {{CREATE INDEX "IF" ON t1(a)}}
do_execsql_test schemaquote-7.2 {
  CREATE UNIQUE INDEX main."IF2" ON t1(a);
  INSERT INTO t1 VALUES(1);
  SELECT count(*) FROM t1;
} {1}

ifcapable trigger {
  reset_db
  do_execsql_test schemaquote-8.1 {
    CREATE TABLE t1(a);
    CREATE TRIGGER main.IF AFTER INSERT ON t1 BEGIN
      UPDATE t1 SET a = a + 10 WHERE rowid = new.rowid;
    END;
    INSERT INTO t1 VALUES(1);
    SELECT a FROM t1;
  } {11}
  do_execsql_test schemaquote-8.2 {
    SELECT instr(sql, '"')>0 FROM sqlite_schema WHERE type='trigger';
  } {1}
}

reset_db
do_execsql_test schemaquote-9.1 {
  CREATE TABLE temp.IF(a);
  INSERT INTO temp."IF" VALUES(4);
  SELECT a FROM temp."IF";
} {4}

reset_db
forcedelete test2.db
do_execsql_test schemaquote-10.1 {
  ATTACH 'test2.db' AS aux;
  CREATE TABLE aux.IF(a);
  INSERT INTO aux."IF" VALUES(8);
  SELECT a FROM aux."IF";
} {8}

reset_db
do_execsql_test schemaquote-12.1 {
  CREATE TABLE main.IF$foo(a);
  SELECT count(*), instr(sql, '"') FROM sqlite_schema;
} {1 0}
reset_db
do_execsql_test schemaquote-12.2 {
  CREATE TABLE main.IF$(a);
  SELECT count(*), instr(sql, '"') FROM sqlite_schema;
} {1 0}
reset_db
do_execsql_test schemaquote-12.3 {
  CREATE TABLE main.IFé(a);
  SELECT count(*), instr(sql, '"') FROM sqlite_schema;
} {1 0}

if {[info exists ::sqlite_options(fts4)] && $::sqlite_options(fts4)} {
  reset_db
  do_execsql_test schemaquote-11.1 {
    CREATE VIRTUAL TABLE main.IF USING fts4(a);
    INSERT INTO "IF"(a) VALUES('x');
    SELECT count(*) FROM "IF";
  } {1}
}

finish_test
