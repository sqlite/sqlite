#***********************************************************************
# This file implements regression tests for compound SELECT statements
# that have ORDER BY clauses with collating sequences that differ
# from the collating sequence used for comparison in the compound.
# 
# Ticket 6709574d2a8d8b9be3a9cb1afbf4ff2de48ea4e7:
# drh added on 2013-05-06 15:21:16:
#
# In the code shown below (which is intended to be run from the
# sqlite3.exe command-line tool) the three SELECT statements should all
# generate the same answer. But the third one does not. It is as if the
# COLLATE clause on the ORDER BY somehow got pulled into the EXCEPT
# operator. Note that the ".print" commands are instructions to the
# sqlite3.exe shell program to output delimiter lines so that you can more
# easily tell where the output of one query ends and the next query
# begins. 
# 
#     CREATE TABLE t1(a);
#     INSERT INTO t1 VALUES('abc'),('def');
#     CREATE TABLE t2(a);
#     INSERT INTO t2 VALUES('DEF');
# 
#     SELECT a FROM t1 EXCEPT SELECT a FROM t2 ORDER BY a;
#     .print -----
#     SELECT a FROM (SELECT a FROM t1 EXCEPT SELECT a FROM t2)
#      ORDER BY a COLLATE nocase;
#     .print -----
#     SELECT a FROM t1 EXCEPT SELECT a FROM t2 ORDER BY a COLLATE nocase;
# 
# Bisecting shows that this problem was introduced in SQLite version 3.6.0
# by check-in [8bbfa97837a74ef] on 2008-06-15. 
#

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix selectE

do_test selectE-1.0 {
  db eval {
    CREATE TABLE t1(a);
    INSERT INTO t1 VALUES('abc'),('def'),('ghi');
    CREATE TABLE t2(a);
    INSERT INTO t2 VALUES('DEF'),('abc');
    CREATE TABLE t3(a);
    INSERT INTO t3 VALUES('def'),('jkl');

    SELECT a FROM t1 EXCEPT SELECT a FROM t2
     ORDER BY a COLLATE nocase;
  }
} {def ghi}
do_test selectE-1.1 {
  db eval {
    SELECT a FROM t2 EXCEPT SELECT a FROM t3
     ORDER BY a COLLATE nocase;
  }
} {abc DEF}
do_test selectE-1.2 {
  db eval {
    SELECT a FROM t2 EXCEPT SELECT a FROM t3
     ORDER BY a COLLATE binary;
  }
} {DEF abc}
do_test selectE-1.3 {
  db eval {
    SELECT a FROM t2 EXCEPT SELECT a FROM t3
     ORDER BY a;
  }
} {DEF abc}

do_execsql_test selectE-1.4 {
  WITH xyz AS (
      SELECT a FROM t2 EXCEPT SELECT a FROM t3 ORDER BY a
  )
  SELECT * FROM xyz;
} {DEF abc}

do_execsql_test selectE-1.5 {
  WITH xyz AS (
      SELECT a FROM t2 EXCEPT SELECT a FROM t3 ORDER BY a COLLATE nocase
  )
  SELECT * FROM xyz;
} {abc DEF}

do_execsql_test selectE-1.6 {
  CREATE VIEW v1 AS SELECT a FROM t2 EXCEPT SELECT a FROM t3 ORDER BY a;
  SELECT * FROM v1;
} {DEF abc}

do_execsql_test selectE-1.7 {
  CREATE VIEW v2 AS 
    SELECT a FROM t2 EXCEPT SELECT a FROM t3 ORDER BY a COLLATE nocase;
  SELECT * FROM v2;
} {abc DEF}

do_test selectE-2.1 {
  db eval {
    DELETE FROM t2;
    DELETE FROM t3;
    INSERT INTO t2 VALUES('ABC'),('def'),('GHI'),('jkl');
    INSERT INTO t3 SELECT lower(a) FROM t2;
    SELECT a COLLATE nocase FROM t2 EXCEPT SELECT a FROM t3
     ORDER BY 1
  }
} {}
do_test selectE-2.2 {
  db eval {
    SELECT a COLLATE nocase FROM t2 EXCEPT SELECT a FROM t3
     ORDER BY 1 COLLATE binary
  }
} {}

do_catchsql_test selectE-3.1 {
  SELECT 1 EXCEPT SELECT 2 ORDER BY 1 COLLATE nocase EXCEPT SELECT 3;
} {1 {ORDER BY clause should come after EXCEPT not before}}

#-------------------------------------------------------------------------
#
reset_db
do_execsql_test 4.0 {
  CREATE TABLE t1(a);
  CREATE TABLE t2(a);
  INSERT INTO t1 VALUES ('def');
  INSERT INTO t2 VALUES ('DEF');
}

do_execsql_test 4.1 {
  WITH c AS MATERIALIZED (
      SELECT a FROM t1
      EXCEPT SELECT a FROM t2
      ORDER BY a COLLATE nocase
  )
  SELECT * FROM c;
} {def}

do_execsql_test 4.2 {
  SELECT a FROM t1 
  EXCEPT SELECT a FROM t2 
  ORDER BY a COLLATE nocase
} {def}

do_execsql_test 4.3 {
  CREATE VIEW vvv AS 
    SELECT a FROM t1 EXCEPT SELECT a FROM t2 ORDER BY a COLLATE nocase;
  SELECT * FROM vvv;
} {def}

#-------------------------------------------------------------------------
reset_db

do_execsql_test 5.0 {
  CREATE TABLE t1(a);
  INSERT INTO t1 VALUES(2), (3), (4), (5);
}

do_execsql_test 5.1.1 {
  SELECT a FROM t1 
    EXCEPT
  SELECT count(*) FROM t1 GROUP BY (a%2)
  ORDER BY 1
} {3 4 5}

do_execsql_test 5.1.2 {
  SELECT a FROM t1 
    EXCEPT
  SELECT count(*) FROM t1 GROUP BY (a%2)
  ORDER BY 1 COLLATE nocase
} {3 4 5}

do_execsql_test 5.2.1 {
  SELECT count(*) FROM t1 GROUP BY (a%2)
    INTERSECT
  SELECT a FROM t1 
  ORDER BY 1
} {2}

do_execsql_test 5.2.2 {
  SELECT count(*) FROM t1 GROUP BY (a%2)
    INTERSECT
  SELECT a FROM t1 
  ORDER BY 1 COLLATE nocase
} {2}

do_execsql_test 5.3.1 {
  SELECT (a * 2) FROM t1
    INTERSECT
  SELECT sum(a) FROM t1 GROUP BY (a%2) HAVING sum(a)>7
  ORDER BY 1
} {8}

do_execsql_test 5.3.2 {
  SELECT (a * 2) FROM t1
    INTERSECT
  SELECT sum(a) FROM t1 GROUP BY (a%2) HAVING sum(a)>7
  ORDER BY 1 COLLATE nocase
} {8}

do_execsql_test 5.4.1 {
  SELECT a FROM t1
    INTERSECT
  SELECT DISTINCT a FROM t1
  ORDER BY 1
} {2 3 4 5}

do_execsql_test 5.4.2 {
  SELECT a FROM t1
    INTERSECT
  SELECT DISTINCT a FROM t1
  ORDER BY 1 COLLATE nocase
} {2 3 4 5}

do_execsql_test 5.5.1 {
  SELECT a FROM t1
    UNION
  SELECT 9
    UNION ALL
  SELECT DISTINCT a FROM t1
  ORDER BY 1
} {2 2 3 3 4 4 5 5 9}

do_execsql_test 5.5.2 {
  SELECT a FROM t1
    UNION
  SELECT 9
    UNION ALL
  SELECT DISTINCT a FROM t1
  ORDER BY 1 COLLATE nocase
} {2 2 3 3 4 4 5 5 9}

#-------------------------------------------------------------------------
# 2026-11-09: https://sqlite.org/bugs/forumpost/52e3f2057f81
#
# When a compound SELECT whose ORDER BY has a COLLATE clause is rewritten
# by convertCompoundSelectToSubquery() as "SELECT * FROM (compound)
# ORDER BY ...", the ORDER BY terms without COLLATE must still sort with
# the collating sequence of the compound: that of the left-most term that
# has one.  The columns of a compound subquery get that collating sequence.
#
reset_db
do_execsql_test 6.0 {
  CREATE TABLE t1(c0 TEXT COLLATE NOCASE, c1 TEXT);
  INSERT INTO t1 VALUES('a','1'),('B','2'),('c','3');
}
do_execsql_test 6.1 {
  SELECT 'D','x' UNION SELECT c0,c1 FROM t1 ORDER BY 1 DESC;
} {D x c 3 B 2 a 1}
do_execsql_test 6.2 {
  SELECT 'D','x' UNION SELECT c0,c1 FROM t1 ORDER BY 1 DESC, 2 COLLATE BINARY;
} {D x c 3 B 2 a 1}
do_execsql_test 6.3 {
  SELECT c0,c1 FROM t1 UNION SELECT 'D','x' ORDER BY 1 DESC, 2 COLLATE BINARY;
} {D x c 3 B 2 a 1}
do_execsql_test 6.4 {
  SELECT 'D','x' UNION ALL SELECT c0,c1 FROM t1
   ORDER BY 1 DESC, 2 COLLATE BINARY;
} {D x c 3 B 2 a 1}
do_execsql_test 6.5 {
  SELECT * FROM (SELECT 'D','x' UNION SELECT c0,c1 FROM t1) ORDER BY 1 DESC;
} {D x c 3 B 2 a 1}
do_execsql_test 6.6 {
  SELECT 'A','9' UNION SELECT c0,c1 FROM t1 ORDER BY 1, 2 COLLATE BINARY;
} {a 1 A 9 B 2 c 3}
do_execsql_test 6.7 {
  CREATE VIEW v1 AS SELECT 'D' AS x,'x' AS y UNION SELECT c0,c1 FROM t1;
  SELECT * FROM v1 ORDER BY x DESC;
} {D x c 3 B 2 a 1}
do_execsql_test 6.8 {
  WITH w(x,y) AS (SELECT 'D','x' UNION SELECT c0,c1 FROM t1)
  SELECT * FROM w ORDER BY x DESC;
} {D x c 3 B 2 a 1}
do_execsql_test 6.9 {
  SELECT 'D','x' UNION SELECT c0,c1 FROM t1
   ORDER BY 1 COLLATE BINARY DESC, 2 COLLATE BINARY;
} {c 3 a 1 D x B 2}
do_execsql_test 6.10 {
  SELECT 'D','x' UNION SELECT c0,c1 FROM t1
   ORDER BY 1 DESC, 2 COLLATE BINARY LIMIT 2;
} {D x c 3}
do_execsql_test 6.11 {
  SELECT 'D','x' INTERSECT SELECT c0,c1 FROM t1 ORDER BY 1 DESC, 2 COLLATE BINARY;
} {}
do_execsql_test 6.12 {
  SELECT 'D','x' UNION ALL SELECT 'b','4' UNION SELECT c0,c1 FROM t1
   ORDER BY 1 DESC, 2 COLLATE BINARY;
} {D x c 3 B 2 b 4 a 1}

finish_test


