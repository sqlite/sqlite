#***********************************************************************
# This file test the busy handler
#


set testdir [file dirname $argv0]
source $testdir/tester.tcl
set testprefix busy

do_test busy-1.1 {
  sqlite3 db2 test.db
  execsql {
    CREATE TABLE t1(x);
    INSERT INTO t1 VALUES(1);
    SELECT * FROM t1
  }
} 1
proc busy x {
  lappend ::busyargs $x
  if {$x>2} {return 1}
  return 0
}
set busyargs {}
do_test busy-1.2 {
  db busy busy
  db2 eval {BEGIN EXCLUSIVE}
  catchsql {BEGIN IMMEDIATE}
} {1 {database is locked}}
do_test busy-1.3 {
  set busyargs
} {0 1 2 3}
do_test busy-1.4 {
  set busyargs {}
  catchsql {BEGIN IMMEDIATE}
  set busyargs
} {0 1 2 3}

do_test busy-2.1 {
  db2 eval {COMMIT}
  db eval {BEGIN; INSERT INTO t1 VALUES(5)}
  db2 eval {BEGIN; SELECT * FROM t1}
  set busyargs {}
  catchsql COMMIT
} {1 {database is locked}}
do_test busy-2.2 {
  set busyargs
} {0 1 2 3}

db2 close

#-------------------------------------------------------------------------
# Test that the busy-handler is invoked correctly for "PRAGMA optimize"
# and ANALYZE commnds.
ifcapable pragma&&analyze&&!stat4 {

reset_db

do_execsql_test 3.1 {
  CREATE TABLE t1(x);
  CREATE TABLE t2(y);
  CREATE TABLE t3(z);

  CREATE INDEX i1 ON t1(x);
  CREATE INDEX i2 ON t2(y);

  INSERT INTO t1 VALUES(1);
  INSERT INTO t2 VALUES(1);
  ANALYZE;

  SELECT * FROM t1 WHERE x=1;
  SELECT * FROM t2 WHERE y=1;
} {1 1}

do_test 3.2 {
  sqlite3 db2 test.db
  execsql { BEGIN EXCLUSIVE } db2
  catchsql { PRAGMA optimize }
} {1 {database is locked}}

proc busy_handler {n} {
  if {$n>1000} { execsql { COMMIT } db2 }
  return 0
}
db busy busy_handler

do_test 3.3 {
  catchsql { PRAGMA optimize }
} {0 {}}

do_test 3.4 {
  execsql {
    BEGIN;
    SELECT count(*) FROM sqlite_master;
  } db2
} {6}

proc busy_handler {n} { return 1 }
do_test 3.5 {
  catchsql { PRAGMA optimize }
} {1 {database is locked}}

do_test 3.6 {
  execsql { COMMIT } db2
  execsql {
    WITH s(i) AS (
      SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
    )
    INSERT INTO t1 SELECT i FROM s;
  }
  execsql {
    BEGIN;
    SELECT count(*) FROM sqlite_master;
  } db2
} {6}

do_test 3.7 {
  catchsql { PRAGMA optimize }
} {1 {database is locked}}

proc busy_handler {n} {
  if {$n>1000} { execsql { COMMIT } db2 }
  return 0
}
do_test 3.8 {
  catchsql { PRAGMA optimize }
} {0 {}}

}


#-------------------------------------------------------------------------
# A statement that gets SQLITE_BUSY from OP_Transaction on an attached
# database, after having started a transaction on main, must not leave
# its statement transaction open. Otherwise a later statement's
# statement-savepoint nests inside it, and a constraint failure in
# that later statement is only partially rolled back.
#
#   https://sqlite.org/bugs/forumpost/53f21c7fcfb416c3
#
# Also check that no "statement aborts" message is sent to the error
# log for an SQLITE_BUSY error.
#
catch { db2 close }
db close
sqlite3_shutdown
test_sqlite3_log [list lappend ::log]
set ::log [list]
reset_db
forcedelete test.db2
do_execsql_test 4.0 {
  ATTACH 'test.db2' AS x;
  CREATE TABLE t(a INTEGER PRIMARY KEY, b UNIQUE);
  INSERT INTO t VALUES(1,1),(2,2),(3,3);
  CREATE TABLE x.u(v);
  CREATE TEMP TRIGGER tr AFTER UPDATE ON t BEGIN
    INSERT INTO u VALUES(new.b);
  END;
}

sqlite3 db2 test.db2
do_execsql_test -db db2 4.1 { BEGIN IMMEDIATE }

do_test 4.2 {
  set P [sqlite3_prepare_v2 db "UPDATE t SET b=b WHERE a=99" -1 dummy]
  set A [sqlite3_prepare_v2 db "UPDATE t SET b=b+10" -1 dummy]
  set B [sqlite3_prepare_v2 db \
      "UPDATE t SET b=CASE a WHEN 2 THEN 13 ELSE b+100 END" -1 dummy
  ]
  list [sqlite3_step $P] [sqlite3_step $A] [sqlite3_step $B]
} {SQLITE_BUSY SQLITE_BUSY SQLITE_BUSY}

do_execsql_test -db db2 4.3 { COMMIT }

do_test 4.4 {
  set res [list]
  foreach s [list $A $B $P] {
    sqlite3_step $s
    lappend res [sqlite3_finalize $s]
  }
  set res
} {SQLITE_OK SQLITE_CONSTRAINT SQLITE_OK}

do_execsql_test 4.5 {
  SELECT * FROM t;
  SELECT * FROM x.u;
} {1 11 2 12 3 13   11 12 13}

do_test 4.6 {
  set res [list]
  foreach {code msg} $::log {
    if {[string match SQLITE_BUSY* $code]} { lappend res $code $msg }
  }
  set res
} {}

db2 close
db close
sqlite3_shutdown
test_sqlite3_log
sqlite3_initialize
sqlite3 db test.db

finish_test
