#***********************************************************************
# This file implements regression tests for SQLite library.
#
# Specifically, it tests cases with order-by-subquery optimization in which
# an ORDER BY in a subquery is used to help resolve an ORDER BY in the
# outer query without having to do an extra sort.
# 

set testdir [file dirname $argv0]
source $testdir/tester.tcl
set ::testprefix orderbyb

db null NULL
do_execsql_test 1.0 {
  CREATE TABLE t1(a TEXT, b TEXT, c INT);
  INSERT INTO t1 VALUES(NULL,NULL,NULL);
  WITH RECURSIVE c(n) AS (VALUES(1) UNION ALL SELECT n+1 FROM c WHERE n<7)
    INSERT INTO t1(a,b,c) SELECT char(p,p), char(q,q), n FROM
            (SELECT ((n-1)%4)+0x61 AS p, abs(n*2-9+(n>=5))+0x60 AS q, n FROM c);
  UPDATE t1 SET b=upper(b) WHERE c=1;
  CREATE TABLE t2(k TEXT PRIMARY KEY, v INT) WITHOUT ROWID;
  WITH RECURSIVE c(n) AS (VALUES(1) UNION ALL SELECT n+1 FROM c WHERE n<7)
    INSERT INTO t2(k,v) SELECT char(0x60+n,0x60+n), n FROM c;
  WITH RECURSIVE c(n) AS (VALUES(1) UNION ALL SELECT n+1 FROM c WHERE n<7)
    INSERT INTO t2(k,v) SELECT char(0x40+n,0x40+n), n FROM c;
  SELECT a,b,c,tx.v AS 'v-a', ty.v AS 'v-b'
    FROM t1 LEFT JOIN t2 AS tx ON tx.k=a
            LEFT JOIN t2 AS ty ON ty.k=b
   ORDER BY c;
} {
  NULL  NULL  NULL  NULL  NULL
  aa    GG    1     1     7
  bb    ee    2     2     5
  cc    cc    3     3     3
  dd    aa    4     4     1
  aa    bb    5     1     2
  bb    dd    6     2     4
  cc    ff    7     3     6
}

do_eqp_execsql_test 1.1 {
  WITH t3(x,y) AS (SELECT a, b FROM t1 ORDER BY a, b LIMIT 8)
    SELECT x, y, v FROM t3 LEFT JOIN t2 ON k=t3.y ORDER BY x, y COLLATE nocase;
} {
  QUERY PLAN
  |--CO-ROUTINE t3
  |  |--SCAN t1
  |  `--USE TEMP B-TREE FOR ORDER BY
  |--SCAN t3
  |--SEARCH t2 USING PRIMARY KEY (k=?) LEFT-JOIN
  `--USE TEMP B-TREE FOR LAST TERM OF ORDER BY
} {
  NULL  NULL  NULL
  aa    bb    2
  aa    GG    7
  bb    dd    4
  bb    ee    5
  cc    cc    3
  cc    ff    6
  dd    aa    1
}

do_eqp_execsql_test 1.2 {
  WITH t3(x,y) AS MATERIALIZED (SELECT a, b COLLATE nocase FROM t1 ORDER BY 1,2)
    SELECT x, y, v FROM t3 LEFT JOIN t2 ON k=t3.y ORDER BY x,y;
} {
  QUERY PLAN
  |--MATERIALIZE t3
  |  |--SCAN t1
  |  `--USE TEMP B-TREE FOR ORDER BY
  |--SCAN t3
  `--SEARCH t2 USING PRIMARY KEY (k=?) LEFT-JOIN
} {
  NULL  NULL  NULL
  aa    bb    2
  aa    GG    7
  bb    dd    4
  bb    ee    5
  cc    cc    3
  cc    ff    6
  dd    aa    1
}


#-------------------------------------------------------------------------
# An inner ORDER BY term that refers to a result column by AS alias or by
# column number, but that has a COLLATE different from that of the
# column, must not be used to satisfy an outer ORDER BY on that column.
#
reset_db
do_execsql_test 2.0 {
  CREATE TABLE t1(a INTEGER, c TEXT);
  CREATE TABLE t2(a INTEGER, c TEXT COLLATE nocase);

  INSERT INTO t1 VALUES(1,'a'),(2,'B'),(3,'A'),(4,'b');
  INSERT INTO t2 VALUES(1,'a'),(2,'B'),(3,'A'),(4,'b');

  CREATE VIEW v1 AS SELECT a, c AS c FROM t1 ORDER BY c COLLATE nocase LIMIT 4;
}

# Control cases - these already sort in BINARY order.
do_execsql_test 2.1.1 {
  SELECT c FROM t1 ORDER BY c;
} {A B a b}
do_execsql_test 2.1.2 {
  SELECT c FROM (SELECT a, c FROM t1 ORDER BY c COLLATE nocase LIMIT 4)
  ORDER BY c;
} {A B a b}
do_execsql_test 2.1.3 {
  SELECT c FROM (SELECT a, c AS c FROM t1 ORDER BY c COLLATE nocase LIMIT 4)
  ORDER BY c COLLATE binary;
} {A B a b}
do_execsql_test 2.1.4 {
  SELECT c FROM (SELECT a, c AS c FROM t1 ORDER BY c COLLATE nocase)
  ORDER BY c;
} {A B a b}

# Inner ORDER BY term refers to result column by alias.
do_execsql_test 2.2.1 {
  SELECT c FROM (SELECT a, c AS c FROM t1 ORDER BY c COLLATE nocase LIMIT 4)
  ORDER BY c;
} {A B a b}
do_execsql_test 2.2.2 {
  SELECT c FROM (SELECT a, c AS c FROM t1 ORDER BY c COLLATE nocase DESC LIMIT 4)
  ORDER BY c DESC;
} {b a B A}
do_execsql_test 2.2.3 {
  SELECT x FROM (SELECT a, c AS x FROM t1 ORDER BY x COLLATE nocase LIMIT 4)
  ORDER BY x;
} {A B a b}

# Inner ORDER BY term refers to result column by number.
do_execsql_test 2.3.1 {
  SELECT c FROM (SELECT a, c FROM t1 ORDER BY 2 COLLATE nocase LIMIT 4)
  ORDER BY c;
} {A B a b}
do_execsql_test 2.3.2 {
  SELECT c FROM (SELECT a, c FROM t1 ORDER BY 2 COLLATE nocase DESC LIMIT 4)
  ORDER BY c DESC;
} {b a B A}

# Subquery is a view.
do_execsql_test 2.4.1 {
  SELECT c FROM v1 ORDER BY c;
} {A B a b}

# Other way around: column is NOCASE, inner ORDER BY uses BINARY. The
# outer ORDER BY must use NOCASE. Use a tie-breaker on "a" to make the
# expected output deterministic.
do_execsql_test 2.5.0 {
  SELECT c FROM t2 ORDER BY c, a;
} {a A B b}
do_execsql_test 2.5.1 {
  SELECT c FROM (SELECT a, c AS c FROM t2 ORDER BY c COLLATE binary LIMIT 4)
  ORDER BY c, a;
} {a A B b}
do_execsql_test 2.5.2 {
  SELECT c FROM (SELECT a, c AS c FROM t2 ORDER BY c COLLATE binary, a LIMIT 4)
  ORDER BY c, a;
} {a A B b}
do_execsql_test 2.5.3 {
  SELECT c FROM (SELECT a, c FROM t2 ORDER BY 2 COLLATE binary, 1 LIMIT 4)
  ORDER BY c, a;
} {a A B b}

# The outer query must still use a sorter.
do_eqp_test 2.6.1 {
  SELECT c FROM (SELECT a, c AS c FROM t1 ORDER BY c COLLATE nocase LIMIT 4)
  ORDER BY c;
} {
  QUERY PLAN
  |--CO-ROUTINE (subquery-xxxxxx)
  |  |--SCAN t1
  |  `--USE TEMP B-TREE FOR ORDER BY
  |--SCAN (subquery-xxxxxx)
  `--USE TEMP B-TREE FOR ORDER BY
}

do_eqp_test 2.6.2 {
  SELECT c FROM (SELECT a, c AS c FROM t1 ORDER BY c LIMIT 4)
  ORDER BY c;
} {
  QUERY PLAN
  |--CO-ROUTINE (subquery-xxxxxx)
  |  |--SCAN t1
  |  `--USE TEMP B-TREE FOR ORDER BY
  `--SCAN (subquery-xxxxxx)
}

finish_test
