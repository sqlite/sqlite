#*************************************************************************
#
# https://sqlite.org/bugs/forumpost/6b41f8e351
#
# Tests for tokenizers that fail part way through tokenizing a document
# while a row is being inserted, updated or deleted. Single-row writes to
# virtual tables do not use statement journals, so such an error may leave
# the table partially modified. After such an error, all subsequent
# xUpdate, xFilter and xSync calls on the table fail with "fts5 tokenizer
# error", until the transaction is rolled back.
#

source [file join [file dirname [info script]] fts5_common.tcl]
set testprefix fts5tokfail

# If SQLITE_ENABLE_FTS5 is not defined, omit this file.
ifcapable !fts5 {
  finish_test
  return
}

# A tokenizer that splits on whitespace and fails if it sees any of the
# tokens in list $::fail_word.
#
set ::fail_word ""
proc tcl_create {args} { return "tcl_tokenize" }
proc tcl_tokenize {tflags text} {
  foreach {w iStart iEnd} [fts5_tokenize_split $text] {
    if {[lsearch -exact $::fail_word $w]>=0} { error "tokenizer failure" }
    sqlite3_fts5_token $w $iStart $iEnd
  }
}

# Return a "snapshot" of the contents of fts5 table t1: the number of
# rows, and the set of rowids matched by each of a few tokens.
#
proc snapshot {} {
  set ret [db one {SELECT count(*) FROM t1}]
  foreach w {a b c d old p q r s} {
    lappend ret $w [db eval {SELECT rowid FROM t1($w) ORDER BY rowid}]
  }
  set ret
}

set TOKERR {1 {fts5 tokenizer error}}

#-------------------------------------------------------------------------
# Each of the following statements fails, either because the tokenizer
# fails when tokenizing the new values ("new" side), or when tokenizing
# the old values of a row being removed from the index ("old" side).
#
# The flags indicate which tables each statement may be run against:
#
#   N: tables that store content (normal content tables, or external
#      content tables).
#   D: contentless_delete=1 tables.
#   C: contentless tables without contentless_delete=1.
#
set lStmt {
  1  NDC new  "INSERT INTO t1(x, y) VALUES('p q FAIL', 'r')"
  2  NDC new  "INSERT INTO t1(rowid, x, y) VALUES(10, 'p q FAIL', 'r')"
  3  ND  new  "INSERT OR REPLACE INTO t1(rowid, x, y) VALUES(1, 'p q FAIL', 'r')"
  4  ND  new  "UPDATE t1 SET x='p q FAIL', y='r' WHERE rowid=1"
  5  ND  new  "UPDATE t1 SET rowid=10, x='p q FAIL', y='r' WHERE rowid=1"
  6  ND  new  "UPDATE OR REPLACE t1 SET rowid=2, x='p q FAIL', y='r'
                WHERE rowid=1"

  7  N   old  "DELETE FROM t1 WHERE rowid=3"
  8  N   old  "UPDATE t1 SET x='p q', y='r' WHERE rowid=3"
  9  N   old  "UPDATE t1 SET y='s' WHERE rowid=3"
  10 N   old  "UPDATE t1 SET rowid=10 WHERE rowid=3"
  11 N   old  "UPDATE OR REPLACE t1 SET rowid=3, x='p q', y='r' WHERE rowid=1"
  12 N   old  "INSERT OR REPLACE INTO t1(rowid, x, y) VALUES(3, 'p q', 'r')"
  13 C   old  "INSERT INTO t1(t1, rowid, x, y) VALUES('delete', 3, 'c old d', 'a')"
  14 N   old  "INSERT INTO t1(t1) VALUES('rebuild')"
}

# Each entry is: name, flags, CREATE VIRTUAL TABLE arguments.
#
set lTable {
  normal      N {x, y}
  columnsize  N {x, y, columnsize=0}
  prefix      N {x, y, prefix='1,2'}
  detailnone  N {x, y, detail=none}
  detailcol   N {x, y, detail=column}
  locale      N {x, y, locale=1}
  secure      N {x, y}
  unindexed   N {x, y, z UNINDEXED}
  external    N {x, y, content=src, content_rowid=id}
  contentless C {x, y, content=''}
  cldelete    D {x, y, content='', contentless_delete=1}
  clunindexed D {x, y, z UNINDEXED, content='',
                 contentless_delete=1, contentless_unindexed=1}
}

proc create_table {tname targs} {
  reset_db
  sqlite3_fts5_create_tokenizer db tcl tcl_create
  set ::fail_word ""

  execsql { CREATE TABLE src(id INTEGER PRIMARY KEY, x, y, z) }
  execsql "CREATE VIRTUAL TABLE t1 USING fts5($targs, tokenize=tcl)"
  if {$tname=="secure"} {
    execsql { INSERT INTO t1(t1, rank) VALUES('secure-delete', 1) }
  }
  set rows {
    1 {a b c} {d}
    2 {b c d} {a}
    3 {c old d} {a}
  }
  foreach {id x y} $rows {
    if {$tname=="external"} {
      execsql { INSERT INTO src(id, x, y) VALUES($id, $x, $y) }
    } else {
      execsql { INSERT INTO t1(rowid, x, y) VALUES($id, $x, $y) }
    }
  }
  if {$tname=="external"} {
    execsql { INSERT INTO t1(t1) VALUES('rebuild') }
  }
}

foreach {tname tflag targs} $lTable {
  foreach {tn sflags side sql} $lStmt {
    if {[string first $tflag $sflags]<0} continue
    if {$tname=="external" && [string match *REPLACE* $sql]} continue

    create_table $tname $targs
    set before [snapshot]
    if {$side=="new"} { set ::fail_word FAIL } else { set ::fail_word old }

    # After the error, all writes, queries and the COMMIT fail. The failed
    # COMMIT rolls the transaction back.
    do_execsql_test 1.$tname.$tn.1 { BEGIN }
    do_catchsql_test 1.$tname.$tn.2 $sql {1 {SQL logic error}}
    set ::fail_word ""
    do_catchsql_test 1.$tname.$tn.3 {
      INSERT INTO t1(rowid, x, y) VALUES(20, 's', 's')
    } $TOKERR
    do_catchsql_test 1.$tname.$tn.4 { SELECT * FROM t1('a') } $TOKERR
    do_catchsql_test 1.$tname.$tn.5 { SELECT count(*) FROM t1 } $TOKERR
    do_catchsql_test 1.$tname.$tn.6 { COMMIT } $TOKERR
    do_test 1.$tname.$tn.7 { sqlite3_get_autocommit db } 1

    do_execsql_test 1.$tname.$tn.8 {
      INSERT INTO t1(t1) VALUES('integrity-check');
    }
    do_test 1.$tname.$tn.9 { snapshot } $before
  }
}

#-------------------------------------------------------------------------
# Rolling back to a savepoint does not clear the error, even if the
# savepoint was opened before the error occurred. Only rolling back the
# transaction does.
#
create_table normal {x, y}
do_execsql_test 2.1 { 
  BEGIN;
    INSERT INTO t1(x, y) VALUES('p', 'q');
    SAVEPOINT one;
}
set ::fail_word FAIL
do_catchsql_test 2.2 {
  INSERT INTO t1(x, y) VALUES('p FAIL', 'q')
} {1 {SQL logic error}}
set ::fail_word ""
do_execsql_test 2.3 { ROLLBACK TO one }
do_catchsql_test 2.4 { SELECT * FROM t1('a') } $TOKERR
do_execsql_test 2.5 { ROLLBACK }
do_execsql_test 2.6 { SELECT count(*) FROM t1('a') } {3}
do_execsql_test 2.7 { 
  INSERT INTO t1(x, y) VALUES('p', 'q');
  SELECT count(*) FROM t1('p');
} {1}

#-------------------------------------------------------------------------
# A tokenizer error in a statement that uses a statement journal (here an
# INSERT ... SELECT) also prevents the transaction from being committed.
#
create_table normal {x, y}
do_execsql_test 3.1.1 { BEGIN }
set ::fail_word FAIL
do_catchsql_test 3.1.2 {
  INSERT INTO t1(x, y) SELECT 'p FAIL', 'q'
} {1 {SQL logic error}}
set ::fail_word ""
do_catchsql_test 3.1.3 { INSERT INTO t1(x, y) VALUES('p', 'q') } $TOKERR
do_catchsql_test 3.1.4 { COMMIT } $TOKERR
do_test 3.1.5 { sqlite3_get_autocommit db } 1
do_execsql_test 3.1.6 { SELECT count(*) FROM t1 } {3}
do_execsql_test 3.1.7 { INSERT INTO t1(t1) VALUES('integrity-check') }

# In autocommit mode, the failed statement is rolled back immediately, so
# subsequent statements are not affected.
set ::fail_word FAIL
do_catchsql_test 3.2.1 {
  INSERT INTO t1(x, y) VALUES('p FAIL', 'q')
} {1 {SQL logic error}}
set ::fail_word ""
do_execsql_test 3.2.2 {
  INSERT INTO t1(x, y) VALUES('p', 'q');
  SELECT count(*) FROM t1('p');
} {1}
do_execsql_test 3.2.3 { INSERT INTO t1(t1) VALUES('integrity-check') }

#-------------------------------------------------------------------------
# OOM tests for the INSERT, UPDATE and DELETE paths.
#
reset_db
do_execsql_test 4.0 {
  CREATE VIRTUAL TABLE t1 USING fts5(x, y, prefix=2);
  INSERT INTO t1(rowid, x, y) VALUES(1, 'one two three', 'four five');
  INSERT INTO t1(rowid, x, y) VALUES(2, 'six seven', 'eight nine ten');
}
faultsim_save_and_close

foreach {tn sql} {
  1 "INSERT INTO t1(rowid, x, y) VALUES(3, 'eleven twelve', 'thirteen')"
  2 "UPDATE t1 SET x='fourteen fifteen' WHERE rowid=1"
  3 "UPDATE t1 SET rowid=5 WHERE rowid=2"
  4 "DELETE FROM t1 WHERE rowid=1"
  5 "INSERT OR REPLACE INTO t1(rowid, x, y) VALUES(2, 'sixteen', 'one')"
} {
  do_faultsim_test 4.$tn -faults oom* -prep {
    faultsim_restore_and_reopen
    execsql { BEGIN }
  } -body {
    execsql $::sql
  } -test {
    faultsim_test_result {0 {}}
    if {$testrc==0} {
      execsql COMMIT
    } else {
      catchsql ROLLBACK
    }
    set res [catchsql { INSERT INTO t1(t1) VALUES('integrity-check') }]
    if {$res!="0 {}"} { error "integrity-check failed: $res" }
  }
}

finish_test
