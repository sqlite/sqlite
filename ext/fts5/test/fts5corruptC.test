#
# Corrupt index handling in fts5DoSecureDelete().
#

source [file join [file dirname [info script]] fts5_common.tcl]
set testprefix fts5corruptC

# If SQLITE_ENABLE_FTS5 is not defined, omit this file.
ifcapable !fts5 {
  finish_test
  return
}
sqlite3_fts5_may_be_corrupt 1

# Bug 2026-11-19T13:05:58Z, issue 1.  The "first rowid" offset in the
# header of a leaf page is larger than the szLeaf field of the same header
# (so it points into the page footer) but not larger than the page size.
# The secure-delete code used to write past the end of the page buffer.
#
reset_db
do_execsql_test 1.0 {
  CREATE VIRTUAL TABLE t USING fts5(x);
  INSERT INTO t(t, rank) VALUES('secure-delete', 1);
  INSERT INTO t(rowid, x) VALUES(5, 'b');
  DELETE FROM t_data WHERE id>10;
  DELETE FROM t_idx;
  UPDATE t_data SET block=x'000000000101010001010102' WHERE id=10;
  INSERT INTO t_data VALUES(137438953473, x'0000000702306204');
  INSERT INTO t_data VALUES(137438953474,
    CAST(x'00cf000705020207' || zeroblob(199) AS BLOB));
}
db close
sqlite3 db test.db
do_catchsql_test 1.1 {
  DELETE FROM t WHERE rowid=5;
} {1 {fts5: corruption in table "t"}}

# Same thing with detail=none.
#
reset_db
do_execsql_test 2.0 {
  CREATE VIRTUAL TABLE t USING fts5(x, detail=none);
  INSERT INTO t(t, rank) VALUES('secure-delete', 1);
  INSERT INTO t(rowid, x) VALUES(5, 'b');
  DELETE FROM t_data WHERE id>10;
  DELETE FROM t_idx;
  UPDATE t_data SET block=x'000000000101010001010102' WHERE id=10;
  INSERT INTO t_data VALUES(137438953473, x'0000000702306204');
  INSERT INTO t_data VALUES(137438953474,
    CAST(x'00cf000705020207' || zeroblob(199) AS BLOB));
}
db close
sqlite3 db test.db
do_catchsql_test 2.1 {
  DELETE FROM t WHERE rowid=5;
} {1 {fts5: corruption in table "t"}}

# Bug 2026-11-19T13:05:58Z, issue 2.  The nSuffix varint of the term that
# follows the one being removed is close to 2^64, so that adding it to the
# offset in the page used to wrap around and pass the bounds check.
#
reset_db
do_execsql_test 3.0 {
  CREATE VIRTUAL TABLE t USING fts5(x);
  INSERT INTO t(t, rank) VALUES('secure-delete', 1);
  INSERT INTO t(rowid, x) VALUES(1, 'a');
  DELETE FROM t_data WHERE id>10;
  DELETE FROM t_idx;
  UPDATE t_data SET block=x'000000000101010001010101' WHERE id=10;
  INSERT INTO t_data VALUES(137438953473,
    x'0000001c02306101020200fffffffffffffffffb00000000000000000406');
}
db close
sqlite3 db test.db
do_catchsql_test 3.1 {
  DELETE FROM t WHERE rowid=1;
} {1 {fts5: corruption in table "t"}}

# The following term claims a prefix (5 bytes) longer than the term being
# removed (2 bytes).
#
reset_db
do_execsql_test 4.0 {
  CREATE VIRTUAL TABLE t USING fts5(x);
  INSERT INTO t(t, rank) VALUES('secure-delete', 1);
  INSERT INTO t(rowid, x) VALUES(1, 'a');
  DELETE FROM t_data WHERE id>10;
  DELETE FROM t_idx;
  UPDATE t_data SET block=x'000000000101010001010101' WHERE id=10;
  INSERT INTO t_data VALUES(137438953473,
    CAST(x'0000001c023061010202050178' || zeroblob(15) || x'0406' AS BLOB));
}
db close
sqlite3 db test.db
do_catchsql_test 4.1 {
  DELETE FROM t WHERE rowid=1;
} {1 {fts5: corruption in table "t"}}

# The delta rowid of the entry that follows the one being removed is a
# varint that extends past the end of the leaf content (detail=none).
do_test 5.0 {
