do_catchsql_test 7.1 {
  DELETE FROM t WHERE rowid=1
} {1 {fts5: corruption in table "t"}}

# Found by fuzzing.  The "first rowid" offset in the header of a leaf page
# is equal to szLeaf, so it points at the start of the page footer rather
# than into the page content.  fts5SegIterNext() used to accept this, and
# then read a position-list size from the new page at the iLeafOffset
# left over from the previous page, past the end of the buffer.
#
do_test 8.0 {
  sqlite3 db {}
  db deserialize [decode_hexdb {
.open --hexdb
