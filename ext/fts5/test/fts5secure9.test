#*************************************************************************
#
# Tests that the 'secure-delete' option may not be enabled on a
# contentless_delete=1 table, but that a table that already has
# secure-delete=1 in its %_config table may still be opened.
#

source [file join [file dirname [info script]] fts5_common.tcl]
ifcapable !fts5 { finish_test ; return }
set ::testprefix fts5secure9

do_execsql_test 1.0 {
  CREATE VIRTUAL TABLE ft USING fts5(x, content='', contentless_delete=1);
  INSERT INTO ft(rowid, x) VALUES(1, 'one two three');
  INSERT INTO ft(rowid, x) VALUES(2, 'four five six');
}

foreach {tn val} {
  1 1
  2 '1'
  3 2
} {
  do_catchsql_test 1.1.$tn "
    INSERT INTO ft(ft, rank) VALUES('secure-delete', $val);
  " {1 {'secure-delete' may not be used with a contentless_delete=1 table}}
}

do_execsql_test 1.2 {
  SELECT * FROM ft_config WHERE k='secure-delete';
} {}

# Setting secure-delete=0 is still allowed.
do_execsql_test 1.3 {
  INSERT INTO ft(ft, rank) VALUES('secure-delete', 0);
  SELECT v FROM ft_config WHERE k='secure-delete';
} {0}

# Invalid values are still reported as such.
do_catchsql_test 1.4 {
  INSERT INTO ft(ft, rank) VALUES('secure-delete', -1);
} {1 {SQL logic error}}

# Ordinary contentless (not contentless_delete) and normal tables are
# unaffected.
do_execsql_test 1.5 {
  CREATE VIRTUAL TABLE ft2 USING fts5(x, content='');
  INSERT INTO ft2(ft2, rank) VALUES('secure-delete', 1);
  CREATE VIRTUAL TABLE ft3 USING fts5(x);
  INSERT INTO ft3(ft3, rank) VALUES('secure-delete', 1);
}

#-------------------------------------------------------------------------
# A contentless_delete=1 table with secure-delete=1 already written to its
# %_config table (e.g. by an earlier version of SQLite) can still be
# opened and used.
#
reset_db
do_execsql_test 2.0 {
  CREATE VIRTUAL TABLE ft USING fts5(x, content='', contentless_delete=1);
  INSERT INTO ft(rowid, x) VALUES(1, 'one two three');
  INSERT INTO ft(rowid, x) VALUES(2, 'four five six');
  INSERT INTO ft_config VALUES('secure-delete', 1);
}

db close
sqlite3 db test.db

do_execsql_test 2.1 {
  SELECT rowid FROM ft('two');
} {1}

do_execsql_test 2.2 {
  INSERT INTO ft(rowid, x) VALUES(3, 'seven eight two');
  DELETE FROM ft WHERE rowid=1;
  SELECT rowid FROM ft('two');
} {3}

do_execsql_test 2.3 {
  INSERT INTO ft(ft) VALUES('integrity-check');
}

# Turning it off is permitted, turning it back on is not.
do_execsql_test 2.4 {
  INSERT INTO ft(ft, rank) VALUES('secure-delete', 0);
}
do_catchsql_test 2.5 {
  INSERT INTO ft(ft, rank) VALUES('secure-delete', 1);
} {1 {'secure-delete' may not be used with a contentless_delete=1 table}}

#-------------------------------------------------------------------------
# Forum post 2ffbdc0ce3. 'rebuild' through a second handle on the same
# table (here, the same file ATTACHed) resets %_config.version to 4 without
# invalidating the other handle's cached config. Subsequent secure-delete
# deletes via the first handle then write version-5-only empty leaves.
#
reset_db
do_execsql_test 3.0 {
  CREATE VIRTUAL TABLE ft USING fts5(x);
  INSERT INTO ft(ft, rank) VALUES('secure-delete', 1);
  INSERT INTO ft(ft, rank) VALUES('pgsz', 64);
  INSERT INTO ft VALUES('alpha');
  DELETE FROM ft WHERE rowid = 1;
}
do_execsql_test 3.1 {
  ATTACH 'test.db' AS aux;
  SELECT count(*) FROM aux.ft;
} {0}
do_execsql_test 3.2 {
  INSERT INTO aux.ft(ft) VALUES('rebuild');
  INSERT INTO main.ft VALUES('beta'), ('gamma'), ('delta');
  DELETE FROM main.ft WHERE rowid IN (1, 2, 3);
}
db close
sqlite3 db test.db
do_execsql_test 3.3 {
  INSERT INTO ft(ft) VALUES('integrity-check');
}

#-------------------------------------------------------------------------
# Similar to the above, but with two separate connections, one of which
# has a stale cookie value when it runs 'rebuild'.
#
reset_db
do_execsql_test 4.0 {
  CREATE VIRTUAL TABLE ft USING fts5(x);
  INSERT INTO ft(ft, rank) VALUES('secure-delete', 1);
  INSERT INTO ft(ft, rank) VALUES('pgsz', 64);
  INSERT INTO ft VALUES('alpha');
  DELETE FROM ft WHERE rowid = 1;
}
sqlite3 db2 test.db
do_execsql_test -db db2 4.1 {
  SELECT count(*) FROM ft;
} {0}
do_execsql_test 4.2 {
  INSERT INTO ft(ft, rank) VALUES('pgsz', 64);
}
do_execsql_test -db db2 4.3 {
  INSERT INTO ft(ft) VALUES('rebuild');
}
do_execsql_test 4.4 {
  INSERT INTO ft VALUES('beta'), ('gamma'), ('delta');
  DELETE FROM ft WHERE rowid IN (1, 2, 3);
}
db2 close
db close
sqlite3 db test.db
do_execsql_test 4.5 {
  INSERT INTO ft(ft) VALUES('integrity-check');
}

finish_test
