#
# The focus of this file is testing the session module.
#

if {![info exists testdir]} {
  set testdir [file join [file dirname [info script]] .. .. test]
} 
source [file join [file dirname [info script]] session_common.tcl]
source $testdir/tester.tcl
ifcapable !session {finish_test; return}
set testprefix sessionfault3

do_execsql_test 1.0 {
  CREATE TABLE t1(a, b, PRIMARY KEY(a));
  INSERT INTO t1 VALUES(1, 2);
  INSERT INTO t1 VALUES(3, 4);
  INSERT INTO t1 VALUES('five', 'six');
}

set C1 [changeset_from_sql {
  INSERT INTO t1 VALUES('seven', 'eight');
  UPDATE t1 SET b=6 WHERE a='five';
  DELETE FROM t1 WHERE a=1;
}]

do_execsql_test 1.1 {
  ALTER TABLE t1 ADD COLUMN d DEFAULT 123;
  ALTER TABLE t1 ADD COLUMN e DEFAULT 'string';
}

set C2 [changeset_from_sql {
  UPDATE t1 SET e='new value' WHERE a='seven';
  INSERT INTO t1 VALUES(0, 0, 0, 0);
}]

do_faultsim_test 1.2 -faults oom* -prep {
  sqlite3changegroup G
} -body {
  G schema db main
  G add $::C1
  G add $::C2
  G output
  set {} {}
} -test {
  catch { G delete }
  faultsim_test_result {0 {}} {1 SQLITE_NOMEM}
}

do_faultsim_test 1.3 -faults oom* -prep {
  sqlite3changegroup G
} -body {
  G schema db main
  G change_begin INSERT t1 0
  G change_int64 new 0 12345
  G change_int64 new 1 67890
  G output
  set {} {}
} -test {
  catch { G delete }
  faultsim_test_result \
     {0 {}} \
     {1 SQLITE_NOMEM} \
     {1 {SQLITE_NOMEM - no such table: t1}}
}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 2.0 {
  CREATE TABLE t1(a INTEGER PRIMARY KEY, b);
  INSERT INTO t1 VALUES(1, 'one');
  INSERT INTO t1 VALUES(2, 'two');
  ALTER TABLE t1 ADD COLUMN c DEFAULT 'abcdefghijklmnopqrstuvwxyz';
}
faultsim_save_and_close

do_faultsim_test 2 -faults oom-t* -prep {
  faultsim_restore_and_reopen
  db eval {SELECT * FROM sqlite_schema}
} -body {
  sqlite3session S db main
  S attach *
  execsql {
    DELETE FROM t1 WHERE a = 1;
  }
} -test {
  faultsim_test_result {0 {}} {1 SQLITE_NOMEM}
  catch { S delete }
}

#-------------------------------------------------------------------------
reset_db
do_execsql_test 3.0 {
  CREATE TABLE t1(a PRIMARY KEY, b UNIQUE);
  INSERT INTO t1 VALUES(1, 'one');
  INSERT INTO t1 VALUES(2, 'two');
  INSERT INTO t1 VALUES(3, 'three');
  INSERT INTO t1 VALUES(4, 'four');
  INSERT INTO t1 VALUES(5, 'five');
}
faultsim_save_and_close
faultsim_restore_and_reopen

set C [changeset_from_sql {
  UPDATE t1 SET b=NULL WHERE a IN (1, 3, 5);
  UPDATE t1 SET b='three' WHERE a=1;
  UPDATE t1 SET b='five' WHERE a=3;
  UPDATE t1 SET b='one' WHERE a=5;
}]

do_execsql_test 3.1 {
  SELECT * FROM t1
} {
  1 three 2 two 3 five 4 four 5 one
}

proc xConflict {args} {
  lappend ::conflict_list $args
  return "OMIT"
}

do_faultsim_test 3 -faults oom* -prep {
  faultsim_restore_and_reopen
  db eval {SELECT * FROM sqlite_schema}
} -body {
  sqlite3changeset_apply_v2 db $::C xConflict
  set {} {}
} -test {
  faultsim_test_result {0 {}} {1 SQLITE_NOMEM}
}

#-------------------------------------------------------------------------
# Test that an OOM in change_begin() or a change_xxx() function does not
# leave a partially constructed change behind. 
#
# Report: https://sqlite.org/bugs/forumpost/875fb2b46f
#
reset_db
do_execsql_test 4.0 {
  CREATE TABLE t1(a INTEGER PRIMARY KEY, b, c, d);
}

do_faultsim_test 4 -faults oom* -prep {
  sqlite3changegroup G
  G schema db main
  G change_begin INSERT t1 0
  G change_finish 1
} -body {
  G change_begin UPDATE t1 0
} -test {
  faultsim_test_result {0 {}} {1 SQLITE_NOMEM}
  if {$testrc} { G change_begin UPDATE t1 0 }
  G change_finish 1
  G delete
}

do_faultsim_test 5 -faults oom* -prep {
  sqlite3changegroup G
  G schema db main
  G change_begin INSERT t1 0
  G change_int64 new 0 1
  G change_int64 new 1 1
  G change_null new 2
  G change_null new 3
  G change_finish 0
  G change_begin INSERT t1 0
  G change_int64 new 0 2
  G change_null new 2
  G change_null new 3
} -body {
  G change_blob new 1 [binary format x400]
} -test {
  faultsim_test_result {0 {}} {1 SQLITE_NOMEM}
  set rc [catch { G change_finish 0 } msg]
  G delete
  if {$testrc} {
    set expect {1 {SQLITE_ERROR - invalid change: column 1 is undefined}}
  } else {
    set expect {0 {}}
  }
  if {[list $rc $msg]!=$expect} {
    error "change_finish returned: [list $rc $msg]"
  }
}

finish_test
