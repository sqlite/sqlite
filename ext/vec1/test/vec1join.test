source [file join [file dirname [info script]] vec1_common.tcl]
set testprefix vec1join
vec1_load db

do_execsql_test 1.0 {
  CREATE VIRTUAL TABLE v1 USING vec1(a);
  INSERT INTO v1(rowid, a) VALUES(1, vec1_from_json('[1,0,0,0]'));
  INSERT INTO v1(rowid, a) VALUES(2, vec1_from_json('[0,1,0,0]'));
  INSERT INTO v1(rowid, a) VALUES(3, vec1_from_json('[0,0,1,0]'));
  INSERT INTO v1(rowid, a) VALUES(4, vec1_from_json('[0,0,0,1]'));
  INSERT INTO v1(rowid, a) VALUES(5, vec1_from_json('[1,1,0,0]'));
  INSERT INTO v1(cmd, arg) VALUES('rebuild', '{index:"flat"}');
  CREATE TABLE q(id INTEGER PRIMARY KEY, qv BLOB);
  INSERT INTO q VALUES(1, vec1_from_json('[1,0,0,0]'));
}

# Q1: literal query vector
do_execsql_test 1.1 {
  SELECT rowid FROM v1(vec1_from_json('[1,0,0,0]'), '{K:2}');
} {1 5}

# Q2: vector from table q, via CROSS JOIN
do_execsql_test 1.2 {
  SELECT v.rowid FROM q CROSS JOIN v1(q.qv, '{K:2}') AS v;
} {1 5}

# Q3: vector from table q, via CROSS JOIN
do_execsql_test 1.3 {
  SELECT v.rowid FROM q, v1(q.qv, '{K:2}') AS v;
} {1 5}

finish_test

