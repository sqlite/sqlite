do_catchsql_test 3.1 {
  INSERT INTO t(rowid, v, m) 
  VALUES (2, vec1_from_json('[5.0,6.0,7.0,8.0]'), 99.0);
} {1 {database disk image is malformed}}


#-------------------------------------------------------------------------
# Tests for corrupt GENERIC format meta-value arrays. Each test case builds
# a table with a single list in %_idx and a GENERIC meta-value array in
# %_meta, corrupts the meta-value array using an SQL UPDATE, then attempts
# one of the following:
#
#   .1  a query with a meta-value filter (vec1DoMetaFilters()),
#   .2  PRAGMA integrity_check,
#   .3  an INSERT that appends to the existing list (vec1ListBuilderLoad()
#       followed by vec1WriteMeta()),
#   .4  two DELETEs, the second of which causes the list to be compacted
#       (vec1ListBuilderCompress()).
#
# GENERIC meta-value arrays are not checked when they are loaded. Corruption
# is only reported if an operation actually trips over it while parsing the
# array. So:
#
#   * The INSERT (.3) never parses the existing array, so it succeeds 
#     unless the 8-byte header itself is corrupt.
#
#   * Corruption that leaves every value parseable within the bounds of
#     the array, such as extra data following the last value, is not 
#     reported by .1 or .4. PRAGMA integrity_check (.2) only reports it if
#     the values it parses do not match those in %_base.
#
# The meta-value array contains one value of each type. Its layout, with
# 1-based byte offsets, is:
#
#    1..8   header (flags=GENERIC|HASNULL, nEntry=7)
#    9..12  'one'           0B 6F6E65
#   13..14  2               01 02
#   15..23  3.5             04 400C000000000000
#   24      NULL            00
#   25..27  x'0102'         0A 0102
#   28..32  100000          02 000186A0
#   33..41  10000000000     03 00000002540BE400
#
proc vec1corrupt_build {} {
  reset_db
  vec1_load db
  execsql {
    CREATE VIRTUAL TABLE v1 USING vec1(v, m);
    INSERT INTO v1(rowid, v, m) VALUES
      (1, vec1_from_json('[1,0,0,0]'), 'one'),
      (2, vec1_from_json('[0,1,0,0]'), 2),
      (3, vec1_from_json('[0,0,1,0]'), 3.5),
      (4, vec1_from_json('[0,0,0,1]'), NULL),
      (5, vec1_from_json('[1,1,0,0]'), x'0102'),
      (6, vec1_from_json('[1,1,1,0]'), 100000),
      (7, vec1_from_json('[1,1,1,1]'), 10000000000);
    INSERT INTO v1(cmd, arg) VALUES('rebuild', '{index:"flat"}');
  }
}

# Return the varint encoding of integer $v, as written by vec1PutVarint(),
# as a hex string.
proc vec1corrupt_varint {v} {
  set res [format %02X [expr {$v & 0x7F}]]
  set v [expr {$v >> 7}]
  while {$v>0} {
    set res "[format %02X [expr {($v & 0x7F) | 0x80}]]$res"
    set v [expr {$v >> 7}]
  }
  set res
}

# Expected results for the 4 operations described above.
#
#   vec1corrupt_ok:      results for an array that is either not corrupt,
#                        or is corrupt in a way that is never tripped over.
#
#   vec1corrupt_parse:   results for an array with a valid header, but that
#                        cannot be parsed. Everything except the INSERT
#                        reports corruption.
#
#   vec1corrupt_header:  results for an array with a corrupt header. All 
#                        4 operations report corruption.
#
set vec1corrupt_malformed {1 {database disk image is malformed}}
set vec1corrupt_intck [list "v1: error reading meta-list id=1,meta=0"]
set vec1corrupt_ok [list {0 1} ok {0 {}} {0 {}}]
set vec1corrupt_parse [list \
  $vec1corrupt_malformed $vec1corrupt_intck {0 {}} $vec1corrupt_malformed
]
set vec1corrupt_header [list \
  $vec1corrupt_malformed $vec1corrupt_intck \
  $vec1corrupt_malformed $vec1corrupt_malformed
]

# Run the 4 operations described above against the meta-value array 
# produced by SQL expression $expr (which may refer to the uncorrupted
# array as "val"). Test case names are $tn.1 through $tn.4. Parameter
# $lExpect is a list of the 4 expected results.
proc vec1corrupt_generic_test {tn expr lExpect} {
  set corrupt "UPDATE v1_meta SET val = ($expr) WHERE id=256"

  vec1corrupt_build
  execsql $corrupt
  do_catchsql_test $tn.1 {
    SELECT rowid FROM v1(vec1_from_json('[1,0,0,0]'), 10) WHERE m='one'
  } [lindex $lExpect 0]

  vec1corrupt_build
  execsql $corrupt
  do_execsql_test $tn.2 {
    PRAGMA integrity_check
  } [lindex $lExpect 1]

  vec1corrupt_build
  execsql $corrupt
  do_catchsql_test $tn.3 {
    INSERT INTO v1(rowid, v, m) VALUES(8, vec1_from_json('[1,2,3,4]'), 'eight')
  } [lindex $lExpect 2]

  vec1corrupt_build
  execsql $corrupt
  do_catchsql_test $tn.4 {
    DELETE FROM v1 WHERE rowid=1;
    DELETE FROM v1 WHERE rowid=2;
  } [lindex $lExpect 3]
}

# Check the layout of the meta-value array is as described above. And
# that the uncorrupted array works.
vec1corrupt_build
do_execsql_test 4.0 {
  SELECT id, hex(val) FROM v1_meta;
} {256 
  00000011000000070B6F6E65010204400C000000000000000A010202000186A00300000002540BE400
}
vec1corrupt_generic_test 4.1 { val } $vec1corrupt_ok

# Truncate the array at every possible point. Truncating it to less than
# 8 bytes corrupts the header.
for {set n 0} {$n<41} {incr n} {
  set lExpect [expr {$n<8 ? $vec1corrupt_header : $vec1corrupt_parse}]
  vec1corrupt_generic_test 4.2.$n " 
    unhex(substr(hex(val), 1, $n*2)) 
  " $lExpect
}

# Extra data following the last value. This is never tripped over.
vec1corrupt_generic_test 4.3.1 { unhex(hex(val) || '00') } $vec1corrupt_ok
vec1corrupt_generic_test 4.3.2 { 
  unhex(hex(val) || '0B6F6E65') 
} $vec1corrupt_ok

# Bad text/blob length varints for the first value. Lengths that are too
# small, too large, negative when cast to a 32-bit int, or a varint that
# runs off the end of the array.
#
# Case 9 is a length just smaller than 2^31. When added to the offset of
# the value within the array (8), plus the size of the varint (5), this
# overflows a 32-bit signed int.
#
# Case 2 makes the first value 1 byte longer than it should be. This
# misaligns the rest of the array, but by chance all 7 values can still
# be parsed without running off the end of it. So the query and DELETE
# succeed, and integrity_check only notices because the parsed values do
# not match those in %_base.
set vec1corrupt_misaligned [list \
  {0 {}} [list "v1: meta-value value mismatch for row 1"] {0 {}} {0 {}}
]
foreach {tn varint lExpect} [list \
  1 09                                        $vec1corrupt_parse      \
  2 0D                                        $vec1corrupt_misaligned \
  3 8F7F                                      $vec1corrupt_parse      \
  4 FF                                        $vec1corrupt_parse      \
  5 [vec1corrupt_varint [expr {0x1FFFFFFFF}]] $vec1corrupt_parse      \
  6 [vec1corrupt_varint [expr {2*0xFFFFFF00 + 5}]] $vec1corrupt_parse \
  7 [vec1corrupt_varint [expr {2*0x7FFFFFFF + 5}]] $vec1corrupt_parse \
  8 FFFFFFFFFFFFFFFFFF7F                      $vec1corrupt_parse      \
  9 [vec1corrupt_varint [expr {2*0x7FFFFFF6 + 5}]] $vec1corrupt_parse \
] {
  vec1corrupt_generic_test 4.4.$tn "
    unhex(substr(hex(val), 1, 16) || '$varint' || substr(hex(val), 19))
  " $lExpect
}

# Bad blob length varint for the 5th value.
foreach {tn varint} [list \
  1 08                                                   \
  2 [vec1corrupt_varint [expr {2*0xFFFFFF00 + 6}]]       \
] {
  vec1corrupt_generic_test 4.5.$tn "
    unhex(substr(hex(val), 1, 48) || '$varint' || substr(hex(val), 51))
  " $vec1corrupt_parse
}

# A varint that is not terminated before the end of the array. 
vec1corrupt_generic_test 4.6.1 { 
  unhex(substr(hex(val), 1, 16) || 'FFFFFFFF') 
} $vec1corrupt_parse
vec1corrupt_generic_test 4.6.2 {
  unhex(substr(hex(val), 1, 64) || 'FFFFFFFFFFFFFFFFFF')
} $vec1corrupt_parse

#-------------------------------------------------------------------------
# A vector in the %_base table that is shorter than the model's vector
# size. The integrity-check must detect this as corruption.
#
reset_db
vec1_load db

do_execsql_test 5.0 {
  CREATE VIRTUAL TABLE v1 USING vec1;
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<1000
  )
  INSERT INTO v1(rowid, vector) SELECT i, random_vector(128) FROM s;
}

do_test 5.1 {
  set T [db one {
    SELECT vec1_train(vector, '{codesize:16, distance:"cos"}') FROM v1
  }]
  execsql { INSERT INTO v1(cmd, vector) VALUES('rebuild', $T) }
} {}

do_execsql_test 5.2 {
  PRAGMA integrity_check
} {ok}

# Truncate the vector stored in one %_base row to 4 bytes. Without the
# length check in the right place, the integrity-check below reads 128
# floats from this 4 byte buffer.
do_execsql_test 5.3 {
  UPDATE v1_base SET vector = x'00000000' WHERE id=1;
} {}

do_execsql_test 5.4 {
  PRAGMA integrity_check
} {{v1: vector in %_base row 1 is wrong size}}

finish_test
