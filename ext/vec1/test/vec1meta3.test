reset_db
vec1_load db

do_execsql_test 7.0 {
  CREATE VIRTUAL TABLE b1 USING vec1(c1, c2);
  INSERT INTO b1 VALUES(random_vector(10), 'hello');
  INSERT INTO b1 VALUES(random_vector(10), 'world');
  INSERT INTO b1 VALUES(random_vector(10), 'one');
  INSERT INTO b1 VALUES(random_vector(10), 'one');
  INSERT INTO b1 VALUES(random_vector(10), 'world');
  INSERT INTO b1(cmd, arg) VALUES('rebuild', '{index:"flat"}');
}

do_execsql_test 7.1 {
  SELECT rowid FROM b1(random_vector(10), 10) 
  WHERE c2 = 'ONE' COLLATE nocase
  ORDER BY 1
} {3 4}

#-------------------------------------------------------------------------
reset_db
vec1_load db

do_execsql_test 8.0 {
  CREATE VIRTUAL TABLE docs USING vec1(embedding, title, size_kb, priority);
  INSERT INTO docs(rowid, embedding, title, size_kb, priority)
    SELECT i, 
           vec1_from_json('['||i||',0,0,0]'), 
           'runbook '||i, (i%5)*100, (i%3)+1
    FROM (
      WITH RECURSIVE r(i) AS (
        SELECT 1 UNION ALL SELECT i+1 FROM r WHERE i<60
      )
      SELECT i FROM r
    );
}

foreach {tn where res} {
  1 "priority IN (1,2) AND size_kb=100" 8
  2 "size_kb=100 AND priority IN (1,2)" 8
  4 "size_kb IN (100,200) AND priority = 1" 8
  5 "priority IN (1,2)" 20
  6 "size_kb = 100" 12
  3 "priority IN (1,2) AND size_kb > 50" 20
} {
breakpoint
  do_execsql_test 8.1.$tn "
    SELECT count(*) 
      FROM docs( vec1_from_json('\[1,0,0,0\]'), 20 )
      WHERE $where
  " [list $res]
}



finish_test

