do_test 1.0 {
  write_db db
} {}

do_execsql_test 1.1 {
  PRAGMA integrity_check
} {ok}

db close
sqlite3 db test.db

if {[catch { vec1_load_scalar db }]} {
  puts "Skipping tests... vec1testscalar.so not built"
  finish_test
  return
}

breakpoint
do_execsql_test 1.2 {
  PRAGMA integrity_check
} {ok}

do_execsql_test 1.3 { DROP TABLE docs }

do_test 1.4 {
  write_db db
} {}

do_execsql_test 1.5 {
  PRAGMA integrity_check
} {ok}

db close
sqlite3 db test.db
vec1_load db

do_execsql_test 1.6 {
  PRAGMA integrity_check
} {ok}


finish_test

