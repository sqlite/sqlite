source [file join [file dirname [info script]] vec1_common.tcl]
set testprefix vec1limit
vec1_load db


do_execsql_test 1.0 { 
  CREATE VIRTUAL TABLE v1 USING vec1(v, a, b);
  INSERT INTO v1 VALUES(random_vector(16), 555, 111);
  DELETE FROM v1;
}

do_catchsql_test 1.1 {
  SELECT * FROM v1(:q) 
} {1 {vec1: unexpected vector blob size 0 bytes, expected 64}}

set q [db one {SELECT random_vector(16)}]
foreach {tn sql} {
  1 { SELECT * FROM v1($q) }
  2 { SELECT * FROM v1($q) ORDER BY vec1_l2_distance(v, $q) LIMIT 10 }
  3 { SELECT * FROM v1($q) WHERE a!=b LIMIT 10 }
  4 { SELECT * FROM v1($q) LIMIT -1 }
  5 { SELECT * FROM v1($q) WHERE a LIKE 'p%' LIMIT 10 }
} {
  do_catchsql_test 1.2.$tn $sql [list \
    1 {vec1: no K value or visible LIMIT clause}
  ]
}

foreach {tn sql} {
  1 { SELECT * FROM v1($q) LIMIT 10 }
  2 { SELECT * FROM v1($q) WHERE a=555 LIMIT 10 }
} {
  do_execsql_test 1.3.$tn $sql {}
}

#-------------------------------------------------------------------------

reset_db
vec1_load db

do_execsql_test 2.0 {
  CREATE TABLE corpus(id INTEGER PRIMARY KEY, v BLOB, title TEXT, cat TEXT);
  INSERT INTO corpus(id,v,title,cat)
    SELECT i, vec1_from_json(
        '['|| (i%17) ||','|| (i%13) ||','|| (i%7) ||','|| (i%5)
            ||','|| (i%23) ||','|| (i%3) ||','|| (i%11) ||','|| (i%19) ||']'
      ), 'runbook '||i, 
      CASE WHEN i%3=0 THEN 'ops' WHEN i%3=1 THEN 'kb' ELSE 'security' END
    FROM (
     WITH RECURSIVE r(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM r WHERE i<2000) 
     SELECT i FROM r
    );
  CREATE VIRTUAL TABLE docs USING vec1(embedding, title, category);
  INSERT INTO docs(rowid, embedding, title, category) 
  SELECT id, v, title, cat FROM corpus;
  INSERT INTO docs(cmd,arg) VALUES('rebuild',(
    SELECT vec1_train(v,'{nbucket:8}') FROM corpus
  ));
}

foreach {tn K} {
  1 576460752303423616
  2 1152921504606852096
  3 1152921504606847232
  4 1152921504606848000
  5 1152921504606847232
} {
  set J "{K:$K, nprobe: 99}"
  set K [expr $K]

  do_catchsql_test 2.1.$tn.1 {
    SELECT count(*) FROM docs( vec1_from_json('[1,2,3,4,5,6,7,8]'), $J );
  } {1 {vec1: K must be an integer value between 0 and 33554432}}

  do_catchsql_test 2.1.$tn.2 {
    SELECT count(*) FROM docs( vec1_from_json('[1,2,3,4,5,6,7,8]'), $K );
  } {1 {vec1: K must be an integer value between 0 and 33554432}}
}




finish_test

