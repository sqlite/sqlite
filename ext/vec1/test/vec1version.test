source [file join [file dirname [info script]] vec1_common.tcl]
set testprefix vec1version
vec1_load db

do_execsql_test 1.0 {
  CREATE VIRTUAL TABLE v1 USING vec1;
}

do_execsql_test 1.1 {
  INSERT INTO v1(rowid, vector) VALUES(1, random_vector(128));
  INSERT INTO v1(rowid, vector) VALUES(2, random_vector(128));
  INSERT INTO v1(rowid, vector) VALUES(3, random_vector(128));
  INSERT INTO v1(rowid, vector) VALUES(4, random_vector(128));
  INSERT INTO v1(rowid, vector) VALUES(5, random_vector(128));

  INSERT INTO v1(cmd, vector) VALUES('rebuild', '{index:"flat"}');
}

do_execsql_test 1.2 { PRAGMA integrity_check } {ok}

do_execsql_test 1.3 {
  SELECT * FROM v1_config WHERE id=5;
} {5 4}

do_execsql_test 1.4 {
  UPDATE v1_config SET val=2 WHERE id=5;
} {}

db close
sqlite3 db test.db
vec1_load db

do_catchsql_test 1.5 {
  SELECT rowid FROM v1(random_vector(128));
} {1 {unrecognized index version}}

do_execsql_test 1.6 {
  UPDATE v1_config SET val=7 WHERE id=5;
} {}

do_catchsql_test 1.7 {
  SELECT rowid FROM v1(random_vector(128));
} {1 {unsupported index version - requires vec1 0.7}}

do_execsql_test 2.0 {
  CREATE VIRTUAL TABLE v2 USING vec1;
  INSERT INTO v2(rowid, vector) VALUES(5, random_vector(128));
  INSERT INTO v2_config(id, val) VALUES(17, 'hello');
}

db close
sqlite3 db test.db
vec1_load db

do_catchsql_test 2.1 {
  SELECT rowid FROM v2(random_vector(128), 4);
} {1 {unrecognized config entry: 17}}

#--------------------------------------------------------------------------

do_execsql_test 3.0 {
  CREATE VIRTUAL TABLE v3 USING vec1;
}

do_execsql_test 3.1 {
  INSERT INTO v3(rowid, vector) VALUES(1, random_vector(128));
  INSERT INTO v3(rowid, vector) VALUES(2, random_vector(128));
  INSERT INTO v3(rowid, vector) VALUES(3, random_vector(128));
  INSERT INTO v3(rowid, vector) VALUES(4, random_vector(128));
  INSERT INTO v3(rowid, vector) VALUES(5, random_vector(128));

  INSERT INTO v3(cmd, vector) VALUES('rebuild', '{index:"flat"}');
}

do_test 3.2 {
  set model [db one {SELECT val FROM v3_model WHERE id=1}]
  set model [string replace $model 0 3 [binary format I 1005]]
  db eval { UPDATE v3_model SET val = $model WHERE id=1 }
} {}

db close
sqlite3 db test.db
vec1_load db

do_catchsql_test 3.3 {
  SELECT rowid FROM v3(random_vector(128), 4);
} {1 {vec1: unsupported model version - require vec1 1.5}}

do_test 3.4 {
  set model [db one {SELECT val FROM v3_model WHERE id=1}]
  set model [string replace $model 0 3 [binary format I 2]]
  db eval { UPDATE v3_model SET val = $model WHERE id=1 }
} {}

db close
sqlite3 db test.db
vec1_load db

do_catchsql_test 3.5 {
  SELECT rowid FROM v3(random_vector(128), 4);
} {1 {vec1: unrecognized model version}}

#--------------------------------------------------------------------------
# A model with the RESIDUAL flag (0x04) set in its header but no buckets
# has no centroids for the residual vectors to be relative to.
#
reset_db
vec1_load db
do_execsql_test 4.0 {
  CREATE VIRTUAL TABLE v4 USING vec1(v);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<600
  )
  INSERT INTO v4 SELECT random_vector(16) FROM s;
  INSERT INTO v4(cmd, arg) VALUES('rebuild', (
    SELECT vec1_train(v, '{quantizer:"pq", codesize:4, nbucket:0}') FROM v4
  ));
}

do_test 4.1 {
  set model [db one {SELECT val FROM v4_model WHERE id=1}]
  binary scan $model IIIII iVersion flags nElem nCodebook nBucket
  list [expr {$flags & 0x04}] $nCodebook $nBucket
} {0 4 0}

do_test 4.2 {
  set model [string replace $model 4 7 [binary format I [expr {$flags|4}]]]
  db eval { UPDATE v4_model SET val = $model WHERE id=1 }
} {}

db close
sqlite3 db test.db
vec1_load db

do_catchsql_test 4.3 {
  SELECT count(*) FROM v4(random_vector(16), 4);
} {1 {vec1: model is corrupt}}

do_catchsql_test 4.4 {
  INSERT INTO v4 VALUES(random_vector(16));
} {1 {vec1: model is corrupt}}

#--------------------------------------------------------------------------
# Test the other conditions that cause vec1 to report "model is corrupt":
#
#   * nElem greater than VEC1_VECSIZE_MAX (4096),
#   * nBucket greater than VEC1_MAX_BUCKET (65536),
#   * nCodebook greater than nElem.
#
reset_db
vec1_load db
do_execsql_test 5.0 {
  CREATE VIRTUAL TABLE v5 USING vec1(v);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<600
  )
  INSERT INTO v5 SELECT random_vector(16) FROM s;
  INSERT INTO v5(cmd, arg) VALUES('rebuild', (
    SELECT vec1_train(v, '{quantizer:"pq", codesize:4, nbucket:4}') FROM v5
  ));
}

do_test 5.1 {
  set good [db one {SELECT val FROM v5_model WHERE id=1}]
  binary scan $good IIIII iVersion flags nElem nCodebook nBucket
  list $nElem $nCodebook $nBucket
} {16 4 4}

do_catchsql_test 5.2 {
  SELECT count(*) FROM v5(random_vector(16), 4);
} {0 4}

# Set the 32-bit header field at byte offset $iOff of the saved model
# to $iVal and write the result into table v5. Then reopen the database.
proc set_model_field {iOff iVal} {
  set m [string replace $::good $iOff [expr {$iOff+3}] [binary format I $iVal]]
  db eval { UPDATE v5_model SET val = $m WHERE id=1 }
  db close
  sqlite3 db test.db
  vec1_load db
}

foreach {tn iOff iVal} {
  1   8   4097
  2   8   0x7FFFFFFF
  3   8   0xFFFFFFFF
  4  16   65537
  5  16   0x7FFFFFFF
  6  16   0xFFFFFFFF
  7  12   17
  8  12   0xFFFFFFFF
} {
  do_test 5.3.$tn.1 { set_model_field $iOff $iVal } {}
  do_catchsql_test 5.3.$tn.2 {
    SELECT count(*) FROM v5(random_vector(16), 4);
  } {1 {vec1: model is corrupt}}
  do_catchsql_test 5.3.$tn.3 {
    INSERT INTO v5 VALUES(random_vector(16));
  } {1 {vec1: model is corrupt}}
}

# Values exactly at the limits pass the header range checks. The
# modified models are still invalid (e.g. they are the wrong size, or
# are inconsistent with the encoded vectors already in the table), so an
# error is still returned. But not "model is corrupt".
foreach {tn iOff iVal err} {
  1   8   4096   {vec1: model size mismatch: *}
  2  16   65536  {vec1: model size mismatch: *}
  3  12   16     {database disk image is malformed}
} {
  do_test 5.4.$tn.1 { set_model_field $iOff $iVal } {}
  do_test 5.4.$tn.2 {
    set res [catchsql { SELECT count(*) FROM v5(random_vector(16), 4) }]
    list [lindex $res 0] [string match $err [lindex $res 1]]
  } {1 1}
}

# Restoring the original model makes the table usable again.
do_test 5.5.1 { set_model_field 0 $iVersion } {}
do_catchsql_test 5.5.2 {
  SELECT count(*) FROM v5(random_vector(16), 4);
} {0 4}

#--------------------------------------------------------------------------
# Check that vec1_train() never generates a model with the RESIDUAL flag
# set but no buckets.
#
reset_db
vec1_load db
do_execsql_test 6.0 {
  CREATE TABLE t6(v);
  WITH s(i) AS (
    SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<600
  )
  INSERT INTO t6 SELECT random_vector(16) FROM s;
}

# Return a list of {flags&0x04 nBucket} for the model generated by
# vec1_train() with configuration $cfg. If $cfg is an empty string,
# vec1_train() is invoked with no configuration argument.
proc train_residual {cfg} {
  if {$cfg==""} {
    set m [db one { SELECT vec1_train(v) FROM t6 }]
  } else {
    set m [db one { SELECT vec1_train(v, $cfg) FROM t6 }]
  }
  binary scan $m IIIII iVersion flags nElem nCodebook nBucket
  list [expr {$flags & 0x04}] $nBucket
}

foreach {tn cfg res} {
  1  {}                                           {0 0}
  2  {{residual:true}}                            {0 0}
  3  {{nbucket:0, residual:true}}                 {0 0}
  4  {{quantizer:"pq", nbucket:0, residual:true}}   {0 0}
  5  {{quantizer:"opq", nbucket:0, residual:true}}  {0 0}
  6  {{quantizer:"bq", nbucket:0, residual:true}}   {0 0}
  7  {{quantizer:"none", nbucket:0, residual:true}} {0 0}
  8  {{codesize:4, nbucket:0, residual:true}}       {0 0}

  9  {{quantizer:"pq", nbucket:4, residual:true}}   {4 4}
  10 {{quantizer:"bq", nbucket:4, residual:true}}   {4 4}
  11 {{quantizer:"pq", nbucket:4, residual:false}}  {0 4}
} {
  do_test 6.1.$tn { train_residual $cfg } $res
}


finish_test

